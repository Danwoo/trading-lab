# 인증 — frontend·backend·MCP 서버 동일값
JWT_SECRET="CHANGE_ME"

# 봇 만들기 대화의 LLM. 이 서비스만 이 키를 쓴다 (다른 서비스는 LLM_* 계열, OpenAI 호환).
# 키가 비어 있으면 서비스는 뜨지만 대화는 사유와 함께 거절된다 — 「인증 경계」는 README 참고.
ANTHROPIC_API_KEY=""

# 에이전트가 읽을 전략 파일 디렉터리. 비워도 된다 — 비우면 레포 루트의 `strategies/` 를 쓴다.
STRATEGIES_DIR=""

# 대화 한 턴의 상한 — 폭주 시 비용 상한이다.
AGENT_MAX_TURNS=12
