{
  "$schema": "https://unpkg.com/knip@5.88.1/schema.json",

  // knip 은 **TypeScript import 그래프**만 본다. 이 레포의 소비자 상당수는 그 밖에 산다 —
  // CI 워크플로가 `node <파일>` 로 실행하는 스크립트, 파이썬 그물이 경로로 열어 파싱하는 상수,
  // prisma 가 문자열로 지정하는 생성기. 그것을 선언하지 않으면 knip 의 「미사용」 목록은
  // **지우면 CI 가 깨지는 것**을 섞어 낸다 (실측: 미사용 파일 8건 전부가 이 부류였다).
  //
  // 아래 항목은 전부 「TS 밖에 소비자가 있다」는 **사실 선언**이다. 「쓰이진 않지만 남긴다」는
  // 판정은 여기 적지 않는다 — 그건 목록에 그대로 남겨 두고 `scripts/check-dead-code.js` 의
  // 상한이 잠근다. 선언으로 감추면 다시는 안 보이지만, 목록에 남으면 매번 보인다.

  "entry": [
    // ── .github/workflows/ci.yml 이 `node scripts/<이름>` 으로 직접 실행한다 ──
    "scripts/check-terminal-devextreme-transitive.js", // ci.yml "전이 devextreme 의존 검사"
    "scripts/check-no-kst-time-in-routes.js", // ci.yml "app/api 라우트 getKSTTime() 재유입 검사"
    "scripts/check-datetime-cell-datatype.js", // ci.yml "시각 셀 dataType 누락 검사"
    "scripts/check-dead-code.js", // ci.yml "죽은 코드 상한" — 이 설정을 읽는 스크립트 자신
    "scripts/check-tables-sql-reproducible.js", // ci.yml "tables.sql 재현 대조"
    "scripts/generate-brand-assets.js", // ci.yml "브랜드 자산 재현 대조" + scripts/verify_public_release_tree.py
    // package.json 의 pretest·predev 훅이 부른다 (npm 이 실행 — import 하는 TS 파일은 없다)
    "scripts/check-deps-sync.js",
    // THIRD-PARTY-NOTICES.md §3 이 Pretendard 재배포 출처를 다시 확인하는 명령으로 적어 둔 도구
    "scripts/verify-woff-name-table.js",
    "scripts/verify-woff2-name-table.js",
    // prisma/schema.prisma 의 `generator table_sql { provider = "node ./prisma/table-generator.cjs" }`
    // 가 실행한다. .github/workflows/ci.yml 과 backend-service/scripts/verify_frontend_fk_referential_actions.py
    // 도 이 경로를 이름으로 참조한다.
    "prisma/table-generator.cjs",
  ],

  "ignore": [
    // styles/globals.css 가 `@import url("fonts.css")` 로 문다 — knip 은 CSS 의 url() 을 풀지 않는다.
    // THIRD-PARTY-NOTICES.md §3 이 이 파일의 @font-face 9개를 재배포 근거로 세고 있다.
    "styles/fonts.css",
  ],

  "ignoreDependencies": [
    // import 하지 않는 **버전 핀**이다 — @better-auth/kysely-adapter 가 kysely 0.29
    // (DEFAULT_MIGRATION_TABLE 제거)로 올라가는 길을 직접 의존성으로 막는다.
    // package.json 의 `//kysely` 주석 · .github/dependabot.yml 의 ignore 항목이 같은 계약이다.
    "kysely",
    // next 가 싣고 오는 전이 패키지. types/global.d.ts 의 `/// <reference types="styled-jsx" />`
    // 가 타입만 끌어 쓴다 — 직접 의존성으로 올리면 next 와 버전이 갈릴 수 있다.
    "styled-jsx",
    // prisma/schema.prisma 의 generator provider 문자열(`node ./prisma/table-generator.cjs`)을
    // knip 의 prisma 플러그인이 패키지 이름으로 읽어 낸 오탐이다. 실행 주체는 node 자신이다.
    "node .",
  ],

  // 개별 export 를 「TS 밖 소비자가 있다」로 선언하는 자리는 이 파일이 아니라 **그 export 의
  // JSDoc `@public` 태그**다 (knip 이 읽는다). 지금 달린 곳: `constants/writeAccess.ts` 의
  // `ROLE_GATED_WRITE_PREFIXES`·`ADMIN_ONLY_WRITE_PREFIXES` — scripts/verify_write_gate_coverage.py
  // 가 소스 텍스트로 읽는다.

  "ignoreUnresolved": [
    // `npx prisma generate` 산출물(prisma/generated/**)이다 — .gitignore 대상이라 체크아웃
    // 직후에는 실재하지 않는다. 이걸 안 걸면 같은 커밋이 generate 전후로 다른 수를 내어
    // 상한이 러너 상태에 따라 흔들린다.
    "@/prisma/generated/client",
  ],

  // 파일 **안에서** 쓰이는 export 는 죽은 코드가 아니라 「과다 노출」이다 — 지우는 손질은
  // `export` 키워드를 떼는 것이지 코드를 지우는 것이 아니다. 그런데 이 레포에서는 그 손질이
  // 안전하지 않다: 파이썬 그물이 `export const DATA_KINDS = [` 같은 **소스 텍스트**를 정규식으로
  // 찾는다 (scripts/verify_capability_kind_lockstep.py). 그래서 이 축은
  // 목록에서 뺀다 — 죽은 코드 상한이 재는 것은 「아무도 안 부르는 코드」다.
  "ignoreExportsUsedInFile": true,
}
