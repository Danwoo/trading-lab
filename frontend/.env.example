# .env.development / .env.staging / .env.production 로 복사 후 값 채우기 (env-cmd 로딩)

# 데이터베이스 (PostgreSQL — 로컬은 process-compose 의 fintech-pg 컨테이너)
# 스키마는 frontend — DB(fintech)는 하나이고 소유만 스키마로 가른다. `prisma db push` 는 연결된
# 스키마 전체를 자기 모델과 동기화하므로, public(파이썬 서비스 소유)에 붙이면 남의 테이블을 지운다.
# (.docs/5-인프라셋팅/로컬-postgres.md 「DB 구성 — 하나의 DB, 두 스키마」)
# 로컬 DB 포트 SoT 는 process-compose.yaml 의 postgres PORT (5432 는 다른 Postgres 와 겹친다 — #294)
#
# 세션 타임존 (#359): 감사 시각 컬럼이 `timestamptz` 라, 오프셋 없는 자릿수를 보내는 경로
# (Prisma 어댑터·psycopg naive 파라미터)에서는 **세션 tz 가 저장 인스턴트를 정한다.**
# 런타임은 코드가 보장하므로(`lib/prisma/sessionTimezone.ts` 가 URL 의 options 를 떼어내 병합)
# 이 값이 없어도 앱은 UTC 로 붙는다. 여기 적어 두는 것은 **CLI 경로**용 방어선이다 —
# `prisma db push`·`prisma db execute`·`psql` 은 코드를 안 거치고 URL 만 본다(실측: CLI 가
# 이 옵션을 그대로 따른다). 값을 UTC 아닌 것으로 바꾸지 마세요 — 앱은 기동에서 막히고,
# CLI 는 안 막힌 채로 틀린 인스턴트를 씁니다.
DATABASE_URL="postgresql://fintech:fintech@localhost:5442/fintech?schema=frontend&options=-c%20timezone%3DUTC"

# EMAIL
# EMAIL_HOST 를 비워 두면 개발에서 인증 코드를 메일 대신 서버 콘솔에 찍는다 — 메일 서버 없이 가입이 된다.
# 실제로 메일을 보내려면 호스트·계정을 채운다 (운영에서는 비워 두어도 콘솔로 새지 않는다).
EMAIL_HOST=""
EMAIL_PORT="465"
EMAIL_USER="CHANGE_ME"
EMAIL_PASSWORD="CHANGE_ME"
EMAIL_SECRET="CHANGE_ME"

# 인증
BETTER_AUTH_SECRET="CHANGE_ME"
# 로컬 프론트 포트 SoT 는 process-compose.yaml 의 frontend PORT (3000 은 다른 프로젝트와 겹친다 — #308)
BETTER_AUTH_URL="http://localhost:3010"
BETTER_AUTH_TRUSTED_ORIGINS=""
JWT_SECRET="CHANGE_ME"

# 서비스 URL
BACKEND_SERVICE_URL="http://localhost:8000"

# 클라이언트 (NEXT_PUBLIC)
NEXT_PUBLIC_APP_EDITION="SAAS"   # SAAS | OEM
NEXT_PUBLIC_FILE_SERVICE_URL="http://localhost:8000"