{
  "name": "fullstack-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "lint": "eslint . --fix",
    "pretest": "node scripts/check-deps-sync.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:api-regressions": "vitest run --config vitest.api-regressions.config.ts",
    "postinstall": "prisma generate",
    "predev": "node scripts/check-deps-sync.js && prisma generate",
    "dev": "env-cmd -f .env.development next dev",
    "build": "env-cmd -f .env.production prisma generate && env-cmd -f .env.production next build",
    "start": "env-cmd -f .env.production next start",
    "dev:start": "env-cmd -f .env.development next start",
    "dev:build": "env-cmd -f .env.development prisma generate && env-cmd -f .env.development next build",
    "staging:build": "env-cmd -f .env.staging prisma generate && env-cmd -f .env.staging next build",
    "staging:start": "env-cmd -f .env.staging next start",
    "dev:prisma:push": "env-cmd -f .env.development prisma db push",
    "dev:prisma:studio": "env-cmd -f .env.development prisma studio",
    "staging:prisma:push": "env-cmd -f .env.staging prisma db push",
    "staging:prisma:studio": "env-cmd -f .env.staging prisma studio",
    "prod:prisma:push": "env-cmd -f .env.production prisma db push",
    "prod:prisma:studio": "env-cmd -f .env.production prisma studio"
  },
  "//kysely": "임시 핀 — @better-auth/kysely-adapter 1.6.12 가 kysely 0.29(DEFAULT_MIGRATION_TABLE 제거)에 미대응해 깨짐. adapter 수정판(1.6.13+) 적용되면 이 kysely 직접 의존성 제거",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "3.14.9",
    "axios": "^1.19.0",
    "better-auth": "^1.6.27",
    "date-fns": "^4.4.0",
    "devextreme-exceljs-fork": "^4.4.13",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "file-saver": "^2.0.5",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.17.0",
    "kysely": "^0.28.17",
    "lightweight-charts": "^5.2.1",
    "next": "^16.3.0",
    "nodemailer": "^9.0.5",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "react-virtuoso": "^4.18.11",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@prisma/generator-helper": "^7.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/file-saver": "^2.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.60.0",
    "autoprefixer": "^10.5.4",
    "env-cmd": "^11.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.26",
    "prisma": "^7.8.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
