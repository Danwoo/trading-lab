# .env.development / .env.staging / .env.production 로 복사 후 값 채우기

# 데이터베이스 (BACKEND) — PostgreSQL (psycopg3 sync)
BACKEND_SQL_DB_DRIVER=postgresql+psycopg
BACKEND_SQL_DB_HOST=localhost
BACKEND_SQL_DB_PORT=5432
BACKEND_SQL_DB_NAME=fintech
BACKEND_SQL_DB_USER=CHANGE_ME
BACKEND_SQL_DB_PASSWORD=CHANGE_ME

# 인증
JWT_SECRET="CHANGE_ME"

# 외부 시장/공시 API 토글 (기본 false → 모의 데이터로 단독 동작)
USE_REAL_API=false

# 시세 소스에 우리를 밝히는 연락처 — 비밀값이 아니다 (SEC 가 이메일 담긴 User-Agent 를 요구).
# 비우면 SEC 종목 마스터 적재가 "연락처 미설정" 사유로 막힌다.
MARKET_DATA_CONTACT="trading-lab/1.0 (contact: CHANGE_ME@example.com)"

# ── 데이터 소스 API 키 ────────────────────────────────────────────────────────
# 전부 비워 둔 채로 기동된다 — 빈 소스는 capability 가 "키 없음" + 발급 경로를 사유로 낸다.
# 자기 것을 발급받아 각자 채운다 (팀 키 공유·커밋 금지, NFR-002). 절차 전문:
#   .docs/5-인프라셋팅/시세-데이터-소스-키-발급.md
# 이 값들은 로그·API 응답·예외 메시지에서 자동으로 가려진다 (app/utils/redaction/).

# 국내 시세·종목마스터 — 공공데이터포털(data.go.kr) 회원가입 → "금융위원회_주식시세정보" 검색 →
# 활용신청 → 마이페이지/개발계정 상세보기 → 일반 인증키. **Encoding 키**를 넣는다
# (Decoding 키를 쿼리에 그대로 넣으면 이중 인코딩으로 Unauthorized Key 가 난다). 한도 10,000회/일.
MARKET_DATA_GOKR_SERVICE_KEY=

# 미국 일봉·분봉·시세 — Alpaca 이메일 가입(증권 실계좌 불요, paper 계정으로 충분) →
# 대시보드 API Keys → Generate New Key. **KEYID:SECRET 형식으로 한 줄**에 넣는다.
# Secret 은 생성 시점에만 전체가 보인다. 한도 분당 200회.
MARKET_DATA_ALPACA_KEY=

# FIGI 별칭 매핑 — 없어도 동작한다(익명 호출). 있으면 배치 한도만 올라간다.
# openfigi.com → Request an API Key.
MARKET_DATA_OPENFIGI_KEY=

# file 모듈 — SFTP (SFTP_BASE_PATH 는 업로드 허용 루트)
SFTP_HOST=localhost
SFTP_PORT=2022
SFTP_USERNAME=CHANGE_ME
SFTP_PASSWORD=CHANGE_ME
SFTP_BASE_PATH=/upload

# chat·report 모듈 — MCP 서버 (비면 portfolio-mcp-service 등록 안됨)
MCP_SERVERS=[{"name": "portfolio", "url": "http://localhost:8002"}]

# LLM (OpenAI 호환 /chat/completions)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=EMPTY

# 메일 (frontend 와 동일 SMTP)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=CHANGE_ME
EMAIL_PASSWORD=CHANGE_ME

# 토스증권 Open API (developers.tossinvest.com)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
