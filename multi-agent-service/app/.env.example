# MCP 서버 (portfolio/market-data/disclosure/news/web/doc-search — process-compose dev 포트)
MCP_SERVERS=[{"name": "portfolio", "url": "http://localhost:8002"}, {"name": "market-data", "url": "http://localhost:8004"}, {"name": "disclosure", "url": "http://localhost:8005"}, {"name": "news", "url": "http://localhost:8006"}, {"name": "web", "url": "http://localhost:8007"}, {"name": "doc-search", "url": "http://localhost:8008"}]

# LLM (OpenAI 호환 vLLM) — Router(소형) / Generator(대형) 2계층
# LLM 제공자 — 가진 키에 맞춰 고릅니다 (openai · groq · together · openrouter · vllm · custom).
# 비우면 custom 이라 아래 BASE_URL 을 직접 읽습니다.
#
# **제공자를 고르면 아래 BASE_URL 을 비우세요.** 설정의 BASE_URL 이 표의 주소를 이기므로,
# 아래 예시 주소를 그대로 둔 채 제공자만 고르면 그 제공자의 키를 **엉뚱한 주소로** 보냅니다
# (사내 게이트웨이로 우회하려면 그대로 두는 것이 맞습니다 — 그때는 의도된 구성입니다).
# 지금 무엇으로 어디에 물어보는지는 GET /agent/llm, 실제로 통하는지는 POST /agent/llm/probe.
ROUTER_LLM_PROVIDER=
GENERATOR_LLM_PROVIDER=
# 주 제공자가 죽으면 넘어갈 자리 — `<제공자>|<모델>|<키>` 를 쉼표로 잇습니다.
# 비우면 폴백 없음(실패가 그대로 드러납니다).
LLM_FALLBACKS=

ROUTER_LLM_BASE_URL=http://198.51.100.35:18080/router/v1
ROUTER_LLM_API_KEY=CHANGE_ME
ROUTER_LLM_MODEL=Qwen/Qwen3.5-9B
# Router/Planner 의 vLLM 전용 extra_body(chat_template_kwargs.enable_thinking=false) 전송 여부.
# 자가 서빙 vLLM(Qwen)이면 true(기본), Groq 등 상용 OpenAI 호환 API 는 400 으로 거부하므로 false.
ROUTER_LLM_VLLM_COMPAT=true
GENERATOR_LLM_BASE_URL=http://198.51.100.36:18080/generator/v1
GENERATOR_LLM_API_KEY=CHANGE_ME
GENERATOR_LLM_MODEL=nvidia/Gemma-4-31B-IT-NVFP4

# 인증
JWT_SECRET="CHANGE_ME"

# 공통 DB (frontend.ai_chat_history 멀티턴 히스토리 read-only) — PostgreSQL (psycopg3 sync)
# DB 는 fintech 하나이고 소유만 스키마로 갈렸다 — 이 테이블은 Prisma 소유라 frontend 스키마에 있다.
# 쿼리가 스키마를 수식하므로(chat_history_repository) 접속 URL 에는 스키마 설정이 없다.
# 포트 SoT 는 process-compose.yaml 의 postgres PORT (5432 는 다른 Postgres 와 겹친다 — #294)
MULTI_AGENT_SQL_DB_DRIVER=postgresql+psycopg
MULTI_AGENT_SQL_DB_HOST=localhost
MULTI_AGENT_SQL_DB_PORT=5442
MULTI_AGENT_SQL_DB_NAME=fintech
MULTI_AGENT_SQL_DB_USER=CHANGE_ME
MULTI_AGENT_SQL_DB_PASSWORD=CHANGE_ME

# langfuse tracing (보류) — 서버 3.5.0 이 OTEL 미지원이라 langchain 1.x(=langfuse v4 OTEL)와 안 맞음.
# 서버가 OTEL 지원 버전이 되면 아래 주석을 풀고 키를 채우면 즉시 작동 (코드는 agent_service 에 이미 있음).
# (보류) LANGFUSE_PUBLIC_KEY=pk-lf-...
# (보류) LANGFUSE_SECRET_KEY=sk-lf-...
# (보류) LANGFUSE_HOST=http://198.51.100.36:11588

# LangSmith tracing (선택) — langchain 1.x 네이티브 관측. API_KEY 채우면 main 이 os.environ 주입해 자동 trace.
# ⚠️ SaaS(api.smith.langchain.com) 라 trace 가 외부로 전송됨 — 사내 데이터(공시·투자 리서치 지식) 주의.
# ⚠️ 개인 계정 키는 git 커밋 금지 — 각자 본인 LangSmith 프로젝트 생성 후 키를 여기 입력 (이 줄은 빈 채로 커밋).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent